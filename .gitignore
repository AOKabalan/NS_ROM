# Computed results (checkpoints, logs, run metadata, generated paper output).
# These dirs also hold .jsonl/.json/.log/.txt/.tex files not caught by the
# extension rules above. Irreplaceable — gitignored, never deleted.
logs/
paper_data/
states/
states_snapshot_prepru/
states_retired/

# Generated at the repo root by nsrom/workflows/hyperreduction_study.py.
# Outputs, not inputs: nothing reads them back.
deim_realized_modes.json
test_A_macros.tex

# Backups and archives (kept on disk, never committed)
*.tgz
*.bak_*
*.prebak_*

# Test capture logs + pytest cache (goldens under tests/golden/ ARE tracked)
tests/*.log
.pytest_cache/

# render/out/ holds the derived CSV + .tex macros that regenerate every paper
# table WITHOUT rerunning a sweep — the key reproducibility asset. Keep those;
# ignore only the heavy generated PDFs. The directory itself must stay
# un-ignored, since a negation cannot re-include a file inside an ignored
# directory. These lines come after the global *.csv rule so they win.
!render/out/*.csv
!render/out/*.tex
render/out/*.pdf
render/out/*.png
